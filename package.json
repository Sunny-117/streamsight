{
  "name": "streamsight-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "StreamSight 用户行为录制与回放系统",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "type-check": "turbo run type-check",
    "publish-packages": "turbo run build --filter='./packages/*' && changeset publish",
    "demo": "pnpm --filter @streamsight/demo-app dev",
    "backend": "pnpm --filter @streamsight/backend-api dev",
    "replay": "pnpm --filter @streamsight/replay-platform dev",
    "e2e": "concurrently \"pnpm backend\" \"pnpm demo\" \"pnpm replay\"",
    "backend:file": "STORAGE_MODE=file pnpm --filter @streamsight/backend-api dev",
    "backend:sql": "STORAGE_MODE=pgsql PGSQL_HOST=localhost PGSQL_PORT=${STREAMSIGHT_PG_PORT:-55432} PGSQL_USER=streamsight PGSQL_PASSWORD=streamsight PGSQL_DATABASE=streamsight pnpm --filter @streamsight/backend-api dev",
    "db:up": "docker compose -f docker-compose.pgsql.yml up -d",
    "db:down": "docker compose -f docker-compose.pgsql.yml down"
  },
  "devDependencies": {
    "@changesets/cli": "^2.26.2",
    "@typescript-eslint/eslint-plugin": "^6.7.4",
    "@typescript-eslint/parser": "^6.7.4",
    "concurrently": "^8.2.2",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.0.3",
    "turbo": "^1.10.14",
    "typescript": "^5.2.2"
  },
  "packageManager": "pnpm@8.7.6",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
