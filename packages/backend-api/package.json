{
  "name": "@streamsight/backend-api",
  "version": "0.1.0",
  "description": "StreamSight 后端 API 服务",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "dev:file": "STORAGE_MODE=file tsx watch src/index.ts",
    "dev:sql": "STORAGE_MODE=pgsql PGSQL_HOST=localhost PGSQL_PORT=${STREAMSIGHT_PG_PORT:-55432} PGSQL_USER=streamsight PGSQL_PASSWORD=streamsight PGSQL_DATABASE=streamsight tsx watch src/index.ts",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^8.4.0",
    "@fastify/multipart": "^8.0.0",
    "dotenv": "^16.3.1",
    "fastify": "^4.24.3",
    "pg": "^8.13.1",
    "streamsight-core-utils": "workspace:*",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.8.0",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^9.0.7",
    "tsx": "^4.6.2",
    "typescript": "^5.2.2"
  }
}
