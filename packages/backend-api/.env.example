# 服务端口
PORT=3001

# 存储模式: file | pgsql
STORAGE_MODE=file

# 本地文件存储目录 (当 STORAGE_MODE=file 时使用)
DATA_DIR=./data

# PostgreSQL 配置 (当 STORAGE_MODE=pgsql 时使用)
# 优先读取 DATABASE_URL，未设置时回退到 PGSQL_*
DATABASE_URL=
PGSQL_HOST=localhost
PGSQL_PORT=55432
PGSQL_USER=streamsight
PGSQL_PASSWORD=streamsight
PGSQL_DATABASE=streamsight
PGSQL_SSL=false

# 日志级别
LOG_LEVEL=info
